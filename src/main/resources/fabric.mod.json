{
  "schemaVersion": 1,
  "id": "style-mod",
  "version": "${version}",
  "name": "Style Mod",
  "description": "Ultrakill-style style meter for Minecraft PvP (client-side)",
  "authors": ["EnderMan21"],
  "contact": {
    "homepage": "https://github.com/shadowender21-sketch/StyleMod-PVPStyle",
    "sources": "https://github.com/shadowender21-sketch/StyleMod-PVPStyle",
    "issues": "https://github.com/shadowender21-sketch/StyleMod-PVPStyle/issues"
  },
  "license": "MIT",
  "icon": "assets/style-mod/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "ru.stylemod.StyleModClient"
    ]
  },
  "mixins": [
    {
      "config": "style-mod.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
